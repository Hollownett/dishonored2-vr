#!/usr/bin/env python3
"""`cl` stand-in for python checks that shell out to the MSVC compiler.

run_build_cmd.py puts this on PATH (as build/linux-harness/bin/cl) while running
python steps; it forwards the cl command line to clang-cl with the same
translation the harness uses for tools/build-msvc.cmd.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import run_build_cmd as harness  # noqa: E402

args = sys.argv[1:]
if "/analyze" in args:
    sys.stderr.write("cl shim: /analyze (MSVC static analysis) is not available with clang-cl\n")
    sys.exit(2)
argv, _ = harness.cl_to_clang(args)
import subprocess  # noqa: E402
p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
text = p.stdout.decode("utf-8", "replace")
sys.stdout.write(text)
problems = harness.tracked_warning_problems(text) if p.returncode == 0 else []
if problems:
    sys.stdout.write("cl shim: warnings cl also raises at /W4 /WX:\n" + "\n".join(problems) + "\n")
sys.exit(p.returncode or (1 if problems else 0))
