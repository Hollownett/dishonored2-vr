<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>obj\bin\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FeaturesTests.cs" />
    <Compile Include="PrefsTests.cs" />
    <Compile Include="..\..\launcher\Prefs.cs" />
    <Compile Include="..\..\launcher\Features.cs" />
    <Compile Include="..\..\launcher\ProxyInstall.cs" />
    <Compile Include="..\..\launcher\DlssFinder.cs" />
    <None Include="..\fixtures\launcher_features\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\vr-settings-v9.cfg" Link="vr-settings-v9.cfg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\default_features.json" Link="default_features.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
